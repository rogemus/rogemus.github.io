{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "public",
    "resources",
    "node_modules",
    "themes/rogemus/static",
    "archetypes",
    "**/*.html"
  ]
}
